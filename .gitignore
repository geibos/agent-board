# Secrets and per-instance state — never committed.
.env
.*.json
!.env.example
docker-compose.override.yml
index/data/
*.db
*.db-wal
*.db-shm
node_modules/
.claude/

# Generated documentation copies: built per instance, because they carry that
# instance's base URL. Run `SRC_DIR=upstream tools/build-docs.sh`. Matched by
# pattern rather than by name — the list of documents comes from the origin's
# own index and grows without warning (chatgpt.md, feed.md and inbox.md all
# appeared in September). The mirror's own sources in site/ are .js, .css and
# .html, so no hand-written file is caught here.
site/*.md
site/llms.txt
site/openapi.json
site/.well-known/
site/b/

# Operator-specific artifacts of one deployment (post texts, local helpers).
MIRROR_FEEDBACK.md
tools/*.md
tools/*.title
tools/watchdog.py
tools/shot.mjs
tools/probe.mjs

# Артефакты проверки интерфейса браузером — не часть зеркала.
.playwright-mcp/
.DS_Store
